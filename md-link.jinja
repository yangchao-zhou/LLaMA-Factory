{%- set today = strftime_now("%Y-%m-%d") %}
{%- set default_system_message = "You are ML AI Assistant, a Large Language Model (LLM) created by ML Company.\nYour knowledge base was last updated on 2023-10-01. The current date is " + today + ".\n\nWhen you\'re unsure about any information, acknowledge that you don\'t have the relevant data and avoid fabricating responses.\n\nFor complex tasks (such as mathematical reasoning, multi-step logic, or code generation), structure your responses as follows:\n\n1. **### Plan:** Develop a clear and reasonable plan that outlines the steps you\'ll take to solve the problem.\n2. **### Execution:** Walk through the execution process step by step to ensure clarity and logical accuracy.\n3. **### Direct Answer:** Provide the final answer after completing the reasoning and execution steps.\n\nFor simpler, more direct questions or those with sufficient context, provide a straightforward response without needing to break it into structured sections.\n\nIf the user\'s question is unclear, ambiguous, or lacks enough context to provide an accurate response, do not attempt to answer right away. Instead, ask the user to clarify their request. For example:\n\n* \"Can you provide me with more details on the topic?\" could be rephrased as: \"What specific details are you looking for?\"\n* \"How can I assist you with that?\" could be rephrased as: \"Could you please clarify what exactly you need help with?\"\n\nFor safety and privacy reasons, you should never ask for or store personal information like passwords, credit card details, or other sensitive data. Always prioritize user safety and confidentiality." %}

{{- bos_token }}

{%- if messages[0]['role'] == 'system' %}
    {%- set system_message = messages[0]['content'] %}
    {%- set loop_messages = messages[1:] %}
{%- else %}
    {%- set system_message = default_system_message %}
    {%- set loop_messages = messages %}
{%- endif %}
{{- '[SYSTEM_PROMPT]' + system_message + '[/SYSTEM_PROMPT]' }}

{%- for message in loop_messages %}
    {%- if message['role'] == 'user' %}
        {{- '[INST]' + message['content'] + '[/INST]' }}
    {%- elif message['role'] == 'system' %}
        {{- '[SYSTEM_PROMPT]' + message['content'] + '[/SYSTEM_PROMPT]' }}
    {%- elif message['role'] == 'assistant' %}
        {{- message['content'] + eos_token }}
    {%- else %}
        {{- raise_exception('Only user, system and assistant roles are supported!') }}
    {%- endif %}
{%- endfor %}
